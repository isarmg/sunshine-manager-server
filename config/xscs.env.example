# Current xscs runtime configuration template.
# Copy to /etc/isarmg/xscs.env, replace the key and administrator password and keep mode 0600.
XSCS_DATABASE_URL=sqlite:///var/lib/isarmg/xscs/db/xscs.sqlite3
XSCS_BIND=127.0.0.1:18104
XSCS_PRODUCTION=true

# Standard Base64 for exactly 32 bytes; startup validation rejects this placeholder.
XSCS_CREDENTIAL_KEY=REPLACE_WITH_STANDARD_BASE64_FOR_EXACTLY_32_RANDOM_BYTES
XSCS_CREDENTIAL_KEY_ID=primary

XSCS_BOOTSTRAP_ADMIN_USERNAME=admin
XSCS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_BYTES
